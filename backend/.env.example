PORT=3000

# ── PostgreSQL (Neon cloud or any hosted Postgres) ───────────────────────────
# After setting DATABASE_URL, run: npm run db:deploy && npm run db:seed
DATABASE_URL="postgresql://USER:PASSWORD@HOST/cafe_erp?sslmode=require"

JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
# Comma-separated browser origins. Production also always allows
# https://erpasolutions.netlify.app (see src/config/cors.ts).
CORS_ORIGIN="http://localhost:5173,https://erpasolutions.netlify.app"

# ── Seed passwords (required for npm run db:seed — never commit real values) ───
OWNER_PASSWORD="your-strong-owner-password"
MANAGER_PASSWORD="your-strong-manager-password"
